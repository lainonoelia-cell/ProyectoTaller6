@{
    ViewData["Title"] = "Ingreso Administrativo";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}



<div class="login-admin">

    <img src="~/images/logommm.png" class="logo-fondo" />

    <h1 class="titulo-admin">Administración MM&M</h1>

    <div id="flashLogin"></div>

    <form method="post" action="/Home/Login" class="form-admin">

        <label>Usuario:</label>
        <input
type="text"
name="usuario"
placeholder="Ingrese su usuario" />

        <label>Contraseña:</label>

<div class="password-box">
   <input
type="password"
id="password"
name="password"
placeholder="Ingrese su contraseña" />

    <span id="ojo"
      class="toggle-password"
      onclick="mostrarPassword()">
    👁
</span>
</div>

        <br />

        <button class="btn-ingresar" type="submit">
            Ingresa
        </button>

        @if (ViewBag.Error != null)
        {
            <p style="color:red; font-weight:bold; margin-top:15px;">
                @ViewBag.Error
            </p>
        }

    </form>


<audio id="sonidoLoginError"
        src="~/sounds/login-error.wav"
        preload="auto">
</audio>
</div>
<script>



function mostrarPassword(){

    let password = document.getElementById("password");
    let ojo = document.getElementById("ojo");

    if(password.type==="password"){
        password.type="text";
        ojo.innerHTML="🙈";
    }
    else{
        password.type="password";
        ojo.innerHTML="👁";
    }

    
}

window.addEventListener("load", function () {

        const mensajeError =
            document.querySelector("p[style*='color:red']");

        const flash =
            document.getElementById("flashLogin");

        const sonido =
            document.getElementById("sonidoLoginError");


        if (mensajeError) {

            flash.classList.add("error");

            sonido.currentTime = 0;

            sonido.play().catch(() => {});


            setTimeout(function () {

                flash.classList.remove("error");

            }, 500);

        }

    });


</script>