}

// =====================================================
// COLORES DE COMBINACIÓN
// =====================================================

function obtenerCombinacion() {

    return [
        color1.value,
        color2.value,
        color3.value
    ].filter(c => c !== "");
}

// =====================================================
// COLOR CSS
// =====================================================

function obtenerColorCSS(color) {

    const colores = {

        "Negro": "#000000",
        "Blanco": "#ffffff",
        "Mostaza": "#e5b800",
        "Azul": "#2563eb",
        "Rojo": "#dc2626",
        "Verde": "#4d7c3a",
        "Rosa": "#ec8ab8",
        "Gris": "#808080",
        "Celeste": "#6ec6e8",
        "Naranja": "#f97316",
        "Lila": "#b794d6",
        "Crema": "#f3e6c8",
        "Bordo": "#7f1d1d",
        "Cemento": "#8c8c8c",
        "Marron": "#795548",
        "Beige": "#d8c3a5",
        "Amarillo": "#ffd900"
    };

    return colores[color] || "#cccccc";
}

// =====================================================
// CLASE CSS COLOR
// =====================================================

function obtenerClaseColor(color) {

    const clases = {

        "Negro": "negro",
        "Blanco": "blanco",
        "Mostaza": "mostaza",
        "Azul": "azul",
        "Rojo": "rojo",
        "Verde": "verde",
        "Rosa": "rosa",
        "Gris": "gris",
        "Celeste": "celeste",
        "Naranja": "naranja",
        "Lila": "lila",
        "Crema": "crema",
        "Bordo": "bordo",
        "Cemento": "cemento",
        "Marron": "marron",
        "Beige": "beige",
        "Amarillo": "amarillo"
    };

    return clases[color] || "";
}

// =====================================================
// GRADIENTE DE COMBINACIÓN
// =====================================================

function obtenerGradienteCombinacion(combinacion) {

    const colores =
        combinacion
            .split("/")
            .map(c => c.trim())
            .filter(c => c !== "");

    if (colores.length === 2) {

        return `
            linear-gradient(
                135deg,
                ${obtenerColorCSS(colores[0])} 0%,
                ${obtenerColorCSS(colores[0])} 50%,
                ${obtenerColorCSS(colores[1])} 50%,
                ${obtenerColorCSS(colores[1])} 100%
            )
        `;
    }

    if (colores.length === 3) {

        return `
            linear-gradient(
                135deg,
                ${obtenerColorCSS(colores[0])} 0%,
                ${obtenerColorCSS(colores[0])} 33.33%,
                ${obtenerColorCSS(colores[1])} 33.33%,
                ${obtenerColorCSS(colores[1])} 66.66%,
                ${obtenerColorCSS(colores[2])} 66.66%,
                ${obtenerColorCSS(colores[2])} 100%
            )
        `;
    }

    return obtenerColorCSS(colores[0]);
}

// =====================================================
// BUSCAR VARIANTE GUARDADA
// =====================================================

function buscarVariante(color, talle) {

    return variantesGuardadas.find(v =>

        v.color &&
        v.color.trim().toLowerCase() ===
            color.trim().toLowerCase() &&

        v.talle &&
        v.talle.trim().toLowerCase() ===
            talle.trim().toLowerCase()
    );
}

// =====================================================
// CREAR BLOQUE DE COLOR
// =====================================================

function crearBloqueColor(
    color,
    cargarDatos = true
) {

    // -----------------------------------------------
    // EVITAR DUPLICADOS
    // -----------------------------------------------

    const bloquesExistentes =
        tallesContainer.querySelectorAll(
            ".bloque-color-talles"
        );

    const yaExiste =
        Array.from(bloquesExistentes).some(
            bloque =>
                bloque.dataset.color
                    .trim()
                    .toLowerCase() ===
                color
                    .trim()
                    .toLowerCase()
        );

    if (yaExiste) {
        return;
    }

    // -----------------------------------------------
    // BLOQUE
    // -----------------------------------------------

    const bloque =
        document.createElement("div");

    bloque.className =
        "bloque-color-talles";

    bloque.dataset.color =
        color;

    // -----------------------------------------------
    // CABECERA
    // -----------------------------------------------

    const cabecera =
        document.createElement("div");

    cabecera.className =
        "cabecera-combinacion";

    const titulo =
        document.createElement("h4");

    if (color.includes("/")) {

        const circulo =
            document.createElement("span");

        circulo.className =
            "color-circulo combinado";

        circulo.style.background =
            obtenerGradienteCombinacion(color);

        titulo.appendChild(circulo);
    }
    else {

        const circulo =
            document.createElement("span");

        circulo.className =
            "color-circulo " +
            obtenerClaseColor(color);

        titulo.appendChild(circulo);
    }

    const texto =
        document.createElement("span");

    texto.textContent =
        " 🎨 " + color;

    titulo.appendChild(texto);

    cabecera.appendChild(titulo);

    // -----------------------------------------------
    // BOTÓN ELIMINAR
    // -----------------------------------------------

    const btnEliminar =
        document.createElement("button");

    btnEliminar.type =
        "button";

    btnEliminar.className =
        "btn-eliminar-combinacion";

    btnEliminar.innerHTML =
        "🗑 Eliminar";

    btnEliminar.addEventListener(
        "click",
        function () {

            bloque.remove();

            generarInputsVariantes();

            actualizarVistaPreviaVariantes();
        }
    );

    cabecera.appendChild(btnEliminar);

    bloque.appendChild(cabecera);

    // -----------------------------------------------
    // TALLES
    // -----------------------------------------------

    const contenedor =
        document.createElement("div");

    contenedor.className =
        "talles-color";

    const talles =
        obtenerTallesDisponibles();

    talles.forEach(talle => {

        // -------------------------------------------
        // BUSCAR VARIANTE EXISTENTE
        // -------------------------------------------

        const variante =
            cargarDatos
                ? buscarVariante(
                    color,
                    talle
                )
                : null;

        const marcado =
            variante != null;

        const stockGuardado =
            variante
                ? variante.stock
                : 0;

        // -------------------------------------------
        // FILA
        // -------------------------------------------

        const fila =
            document.createElement("div");

        fila.className =
            "fila-talle";

        // -------------------------------------------
        // LABEL
        // -------------------------------------------

        const label =
            document.createElement("label");

        label.className =
            "talle-opcion";

        // -------------------------------------------
        // CHECKBOX
        // -------------------------------------------

        const checkbox =
            document.createElement("input");

        checkbox.type =
            "checkbox";

        checkbox.className =
            "talle-checkbox";

        checkbox.value =
            talle;

        checkbox.checked =
            marcado;

        // -------------------------------------------
        // TEXTO
        // -------------------------------------------

        const textoTalle =
            document.createElement("span");

        textoTalle.textContent =
            talle;

        label.appendChild(
            checkbox
        );

        label.appendChild(
            textoTalle
        );

        // -------------------------------------------
        // STOCK
        // -------------------------------------------

        const stock =
            document.createElement("input");

        stock.type =
            "number";

        stock.className =
            "stock-variante";

        stock.dataset.color =
            color;

        stock.dataset.talle =
            talle;

        stock.min =
            "0";

        stock.value =
            stockGuardado;

        stock.disabled =
            !marcado;

        stock.placeholder =
            "Stock";

        // -------------------------------------------
        // EVENTO CHECKBOX
        // -------------------------------------------

        checkbox.addEventListener(
            "change",
            function () {

                stock.disabled =
                    !checkbox.checked;

                if (!checkbox.checked) {

                    stock.value = 0;
                }

                generarInputsVariantes();

                actualizarVistaPreviaVariantes();
            }
        );

        // -------------------------------------------
        // EVENTO STOCK
        // -------------------------------------------

        stock.addEventListener(
            "input",
            function () {

                generarInputsVariantes();

                actualizarVistaPreviaVariantes();
            }
        );

        fila.appendChild(label);

        fila.appendChild(stock);

        contenedor.appendChild(fila);
    });

    bloque.appendChild(
        contenedor
    );

    tallesContainer.appendChild(
        bloque
    );
}

// =====================================================
// CARGAR TALLES
// =====================================================

function cargarTalles() {

    tallesContainer.innerHTML = "";

    // =================================================
    // COMBINACIÓN
    // =================================================

    if (usarCombinacion.checked) {

        const colores =
            obtenerCombinacion();

        if (colores.length < 2) {

            tallesContainer.innerHTML = `
                <p class="sin-talles">
                    Seleccioná al menos 2 colores
                    para combinar.
                </p>
            `;

            generarInputsVariantes();

            return;
        }

        const combinacion =
            colores.join(" / ");

        crearBloqueColor(
            combinacion,
            true
        );

    }

    // =================================================
    // COLORES INDIVIDUALES
    // =================================================

    else {

        const colores =
            obtenerColoresSeleccionados();

        if (colores.length === 0) {

            tallesContainer.innerHTML = `
                <p class="sin-talles">
                    Seleccioná un color para ver
                    sus talles.
                </p>
            `;

            generarInputsVariantes();

            return;
        }

        colores.forEach(color => {

            crearBloqueColor(
                color,
                true
            );
        });
    }

    generarInputsVariantes();

    actualizarVistaPreviaVariantes();
}

// =====================================================
// GENERAR INPUTS HIDDEN
// =====================================================

function generarInputsVariantes() {

    variantesHidden.innerHTML = "";

    const bloques =
        tallesContainer.querySelectorAll(
            ".bloque-color-talles"
        );

    bloques.forEach(bloque => {

        const color =
            bloque.dataset.color;

        const checks =
            bloque.querySelectorAll(
                ".talle-checkbox:checked"
            );

        checks.forEach(check => {

            const talle =
                check.value;

            const stockInput =
                bloque.querySelector(
                    `.stock-variante[data-talle="${CSS.escape(talle)}"]`
                );

            const stock =
                stockInput
                    ? parseInt(stockInput.value) || 0
                    : 0;

            // ---------------------------------------
            // COLOR
            // ---------------------------------------

            const inputColor =
                document.createElement("input");

            inputColor.type =
                "hidden";

            inputColor.name =
                "VariantesColor";

            inputColor.value =
                color;

            // ---------------------------------------
            // TALLE
            // ---------------------------------------

            const inputTalle =
                document.createElement("input");

            inputTalle.type =
                "hidden";

            inputTalle.name =
                "VariantesTalle";

            inputTalle.value =
                talle;

            // ---------------------------------------
            // STOCK
            // ---------------------------------------

            const inputStock =
                document.createElement("input");

            inputStock.type =
                "hidden";

            inputStock.name =
                "VariantesStock";

            inputStock.value =
                stock;

            variantesHidden.appendChild(
                inputColor
            );

            variantesHidden.appendChild(
                inputTalle
            );

            variantesHidden.appendChild(
                inputStock
            );
        });
    });
}

// =====================================================
// PREVIEW
// =====================================================

function actualizarVistaPreviaVariantes() {

    let previewExistente =
        document.getElementById(
            "previewVariantes"
        );

    if (!previewExistente) {

        previewExistente =
            document.createElement("div");

        previewExistente.id =
            "previewVariantes";

        const previewCard =
            document.querySelector(
                ".preview-card"
            );

        if (previewCard) {

            previewCard.appendChild(
                previewExistente
            );
        }
    }

    if (!previewExistente) {
        return;
    }

    let html = `
        <div class="preview-variantes">

            <strong>
                🎨 Colores y talles
            </strong>
    `;

    const bloques =
        tallesContainer.querySelectorAll(
            ".bloque-color-talles"
        );

    if (bloques.length === 0) {

        html += `
            <p class="sin-talles-preview">
                No hay colores ni combinaciones seleccionadas.
            </p>
        `;
    }

    bloques.forEach(bloque => {

        const color =
            bloque.dataset.color;

        const checks =
            bloque.querySelectorAll(
                ".talle-checkbox:checked"
            );

        html += `
            <div class="preview-color-talles">

                <div class="preview-color-nombre">
        `;

        // -------------------------------------------
        // COLOR
        // -------------------------------------------

        if (color.includes("/")) {

            html += `
                <span
                    class="color-circulo combinado"
                    style="
                        background:
                        ${obtenerGradienteCombinacion(color)};
                    ">
                </span>
            `;
        }
        else {

            html += `
                <span
                    class="color-circulo
                    ${obtenerClaseColor(color)}">
                </span>
            `;
        }

        html += `
                    <strong>
                        ${color}
                    </strong>

                </div>

                <div class="preview-talles">
        `;

        // -------------------------------------------
        // TALLES
        // -------------------------------------------

        if (checks.length === 0) {

            html += `
                <span class="sin-talles-preview">
                    Sin talles seleccionados
                </span>
            `;
        }
        else {

            checks.forEach(check => {

                const talle =
                    check.value;

                const stockInput =
                    bloque.querySelector(
                        `.stock-variante[data-talle="${CSS.escape(talle)}"]`
                    );

                const stock =
                    stockInput
                        ? parseInt(stockInput.value) || 0
                        : 0;

                html += `
                    <span class="talle-preview">

                        ${talle}

                        <small>
                            (Stock: ${stock})
                        </small>

                    </span>
                `;
            });
        }

        html += `
                </div>
            </div>
        `;
    });

    html += `
        </div>
    `;

    previewExistente.innerHTML =
        html;
}

// =====================================================
// ACTUALIZAR COMBINACIÓN
// =====================================================

function actualizarCombinacion() {

    const colores =
        obtenerCombinacion();

    vistaCombinacion.innerHTML =
        "";

    if (colores.length < 2) {

        colorFinal.value =
            "";

        return;
    }

    // -----------------------------------------------
    // NO REPETIR COLORES
    // -----------------------------------------------

    if (
        new Set(colores).size !==
        colores.length
    ) {

        vistaCombinacion.innerHTML = `
            <p>
                ⚠️ No podés repetir un color.
            </p>
        `;

        colorFinal.value =
            "";

        return;
    }

    const combinacion =
        colores.join(" / ");

    colorFinal.value =
        combinacion;

    const gradiente =
        obtenerGradienteCombinacion(
            combinacion
        );

    vistaCombinacion.innerHTML = `
        <div class="preview-combinacion">

            <span
                class="color-circulo combinado"
                style="
                    background:
                    ${gradiente};
                ">
            </span>

            <strong>
                ${combinacion}
            </strong>

        </div>
    `;
}

// =====================================================
// AGREGAR COMBINACIÓN
// =====================================================

btnAgregarCombinacion.addEventListener(
    "click",
    function () {

        const colores =
            obtenerCombinacion();

        if (colores.length < 2) {

            alert(
                "⚠️ Seleccioná al menos 2 colores."
            );

            return;
        }

        if (
            new Set(colores).size !==
            colores.length
        ) {

            alert(
                "⚠️ No podés repetir un color."
            );

            return;
        }

        const combinacion =
            colores.join(" / ");

        // -------------------------------------------
        // CREAR BLOQUE SIN DATOS ANTERIORES
        // -------------------------------------------

        crearBloqueColor(
            combinacion,
            false
        );

        // -------------------------------------------
        // LIMPIAR SELECTORES
        // -------------------------------------------

        color1.value =
            "";

        color2.value =
            "";

        color3.value =
            "";

        vistaCombinacion.innerHTML =
            "";

        generarInputsVariantes();

        actualizarVistaPreviaVariantes();
    }
);

// =====================================================
// CAMBIO DE SELECTORES DE COMBINACIÓN
// =====================================================

color1.addEventListener(
    "change",
    actualizarCombinacion
);

color2.addEventListener(
    "change",
    actualizarCombinacion
);

color3.addEventListener(
    "change",
    actualizarCombinacion
);

// =====================================================
// ACTIVAR / DESACTIVAR COMBINACIONES
// =====================================================

usarCombinacion.addEventListener(
    "change",
    function () {

        if (usarCombinacion.checked) {

            selectorCombinacion.style.display =
                "block";

            // Desmarcar individuales

            document
                .querySelectorAll(
                    ".color-checkbox"
                )
                .forEach(c => {

                    c.checked =
                        false;
                });

            colorFinal.value =
                "";

            vistaCombinacion.innerHTML =
                "";

            cargarTalles();
        }

        else {

            selectorCombinacion.style.display =
                "none";

            color1.value =
                "";

            color2.value =
                "";

            color3.value =
                "";

            colorFinal.value =
                "";

            vistaCombinacion.innerHTML =
                "";

            cargarTalles();
        }
    }
);

// =====================================================
// CAMBIO DE COLOR INDIVIDUAL
// =====================================================

document
    .querySelectorAll(
        ".color-checkbox"
    )
    .forEach(input => {

        input.addEventListener(
            "change",
            function () {

                if (
                    usarCombinacion.checked
                ) {
                    return;
                }

                cargarTalles();
            }
        );
    });

// =====================================================
// CARGAR DATOS EXISTENTES AL EDITAR
// =====================================================

function cargarDatosExistentes() {

    if (
        !variantesGuardadas ||
        variantesGuardadas.length === 0
    ) {

        // Si no hay variantes pero existe Color
        // dejamos preparado el selector.

        const colorGuardado =
            '@Model.Color'.trim();

        if (
            colorGuardado.includes("/")
        ) {

            usarCombinacion.checked =
                true;

            selectorCombinacion.style.display =
                "block";

            const partes =
                colorGuardado
                    .split("/")
                    .map(c => c.trim())
                    .filter(c => c !== "");

            color1.value =
                partes[0] || "";

            color2.value =
                partes[1] || "";

            color3.value =
                partes[2] || "";

            actualizarCombinacion();
        }

        return;
    }

    // =================================================
    // OBTENER COLORES GUARDADOS
    // =================================================

    const coloresGuardados =
        [
            ...new Set(
                variantesGuardadas
                    .map(v =>
                        v.color
                            ? v.color.trim()
                            : ""
                    )
                    .filter(c => c !== "")
            )
        ];

    // =================================================
    // ¿ES COMBINACIÓN?
    // =================================================

          // =================================================
// ¿ES COMBINACIÓN?
// =================================================

const combinaciones =
    coloresGuardados.filter(
        color => color.includes("/")
    );

if (combinaciones.length > 0) {

    // ---------------------------------------------
    // MODO COMBINACIÓN
    // ---------------------------------------------

    usarCombinacion.checked =
        true;

    selectorCombinacion.style.display =
        "block";

    // ---------------------------------------------
    // LIMPIAR TAMAÑOS ANTERIORES
    // ---------------------------------------------

    tallesContainer.innerHTML = "";

    // ---------------------------------------------
    // CREAR TODAS LAS COMBINACIONES GUARDADAS
    // ---------------------------------------------

    combinaciones.forEach(combinacion => {

        crearBloqueColor(
            combinacion,
            true
        );

    });

    // ---------------------------------------------
    // MOSTRAR LA PRIMERA COMBINACIÓN
    // EN LOS SELECTORES
    // ---------------------------------------------

    const primeraCombinacion =
        combinaciones[0];

    const partes =
        primeraCombinacion
            .split("/")
            .map(c => c.trim())
            .filter(c => c !== "");

    color1.value =
        partes[0] || "";

    color2.value =
        partes[1] || "";

    color3.value =
        partes[2] || "";

    actualizarCombinacion();

    // ---------------------------------------------
    // GENERAR HIDDEN + PREVIEW
    // ---------------------------------------------

    generarInputsVariantes();

    actualizarVistaPreviaVariantes();
}

    else {

        // ---------------------------------------------
        // MODO COLOR INDIVIDUAL
        // ---------------------------------------------

        usarCombinacion.checked =
            false;

        selectorCombinacion.style.display =
            "none";

        // ---------------------------------------------
        // MARCAR LOS COLORES GUARDADOS
        // ---------------------------------------------

        document
            .querySelectorAll(
                ".color-checkbox"
            )
            .forEach(input => {

                const valor =
                    input.value
                        .trim()
                        .toLowerCase();

                input.checked =
                    coloresGuardados.some(
                        color =>
                            color
                                .trim()
                                .toLowerCase() ===
                            valor
                    );
            });

        // =================================================
        // MUY IMPORTANTE
        // =================================================
        // Esto es lo que hacía funcionar tu segundo código.
        // Ahora vuelve a ejecutarse al editar.

        cargarTalles();
    }

    generarInputsVariantes();

    actualizarVistaPreviaVariantes();
}

// =====================================================
// INICIALIZAR
// =====================================================

cargarDatosExistentes();

actualizarVistaPreviaVariantes();

// =====================================================
// ANTES DE ENVIAR
// =====================================================

const formulario =
    document.querySelector("form");

if (formulario) {

    formulario.addEventListener(
        "submit",
        function () {

            generarInputsVariantes();
        }
    );
}

