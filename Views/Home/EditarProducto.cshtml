<script>

const stockInput = document.getElementById("stock");

function actualizarColorStock() {

    let stock = parseInt(stockInput.value);

    stockInput.classList.remove(
        "stock-ok",
        "stock-bajo",
        "stock-agotado"
    );

    if(stock === 0){
        stockInput.classList.add("stock-agotado");
    }
    else if(stock <= 5){
        stockInput.classList.add("stock-bajo");
    }
    else{
        stockInput.classList.add("stock-ok");
    }
}

actualizarColorStock();

stockInput.addEventListener(
    "input",
    actualizarColorStock
);


