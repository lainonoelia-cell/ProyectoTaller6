// =====================================================
// TAMAÑOS DISPONIBLES
// =====================================================

function obtenerTallesDisponibles() {

    const categoriaNormalizada =
        categoria.toLowerCase().trim();

    const tipoNormalizado =
        tipo.toLowerCase().trim();

    if (categoriaNormalizada === "pantalones") {

        return [
            "38",
            "40",
            "42",
            "44",
            "46",
            "48",
            "50"
        ];
    }

    if (
        categoriaNormalizada === "remeras/camisetas" ||
        categoriaNormalizada === "chombas" ||
        categoriaNormalizada === "abrigos"
    ) {

        return [
            "S",
            "M",
            "L",
            "XL",
            "XXL",
            "XXXL"
        ];
    }

    if (categoriaNormalizada === "cortos") {

        if (tipoNormalizado.includes("bermuda")) {

            return [
                "38",
                "40",
                "42",
                "44",
                "46",
                "48",
                "50"
            ];
        }

        return [
            "S",
            "M",
            "L",
            "XL",
            "XXL",
            "XXXL"
        ];
    }

    if (categoriaNormalizada === "interiores") {

        if (
            tipoNormalizado.includes("calzoncillos")
        ) {

            return [
                "S",
                "M",
                "L",
                "XL",
                "XXL",
                "XXXL"
            ];
        }

        return ["Único"];
    }

    if (categoriaNormalizada === "accesorios") {

        return ["Único"];
    }

    return [];
}

// =====================================================
// COLORES INDIVIDUALES SELECCIONADOS
// =====================================================

function obtenerColoresSeleccionados() {

