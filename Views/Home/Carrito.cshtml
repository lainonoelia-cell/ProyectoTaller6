@{
    ViewData["Title"] = "Carrito";
    Layout = "_Layout";

    var usuarioRed = ViewBag.Usuario as string ?? "";
    var redSocial = ViewBag.Red as string ?? "";
}


    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carrito - MM Indumentaria</title>
    <link rel="stylesheet" href="~/css/carrito.css" />


<div class="carrito-panel">

    <!-- HEADER -->
    <div class="header-carrito">
    <h1><span id="iconoCarrito">🛒</span> Mi Carrito</h1>
</div>

    <!-- LISTA PRODUCTOS -->
    <div id="carritoContainer" class="carrito-container">
    </div>

    <!-- TOTAL -->
    <div class="total-section">
        <h2>Total: <span id="totalCarrito">$0</span></h2>
    </div>

    <!-- CLIENTE REGISTRADO -->
<div class="datos-cliente">
    <span>👤 Cliente:</span>

    <strong>
        @usuarioRed
    </strong>

    @if (!string.IsNullOrWhiteSpace(redSocial))
    {
        <span class="red-cliente">
            — Registrado mediante @redSocial
        </span>
    }
</div>


    <!-- BOTONES -->
    <div class="botones-carrito">

    <button class="btn-vaciar" onclick="vaciarCarrito()">
        🗑 Vaciar carrito
    </button>

    <button class="btn-ticket" onclick="generarTicket()">
        🧾 Generar ticket
    </button>

    <button class="btn-whatsapp" onclick="enviarWhatsApp()">
    📱 Enviar pedido a WhatsApp
</button>

</div>

</div>

<script>

let carrito = [];

function cargarCarrito() {

    const container = document.getElementById('carritoContainer');
    const totalSpan = document.getElementById('totalCarrito');

    if (carrito.length === 0) {

        container.innerHTML = `
            <div class="carrito-vacio">
                No hay productos en el carrito
            </div>
        `;

        totalSpan.innerText = '$0';
        return;
    }

    let total = 0;

    container.innerHTML = carrito.map((item, index) => {

        const subtotal = item.precio * item.cantidad;

        total += subtotal;

        // Si el producto todavía no tiene forma de pago,
        // la dejamos vacía.
        if (!item.formaPago) {
            item.formaPago = "";
        }

        return `
            <div class="card-carrito">

                <div class="info-producto">

                    <h3>${item.nombre}</h3>

                    <p>Talle: ${item.talle}</p>

                    <p>Cantidad: ${item.cantidad}</p>

                    <p class="precio">
                        $${subtotal.toLocaleString()}
                    </p>

                    <div class="pago-producto">

                        <label>
                            💳 Forma de pago:
                        </label>

                        <select
                            onchange="cambiarFormaPago(${index}, this.value)"
                        >

                            <option value="">
                                Seleccioná cómo abonás
                            </option>

                            <option value="Efectivo"
                                ${item.formaPago === "Efectivo" ? "selected" : ""}>
                                💵 Efectivo
                            </option>

                            <option value="Transferencia bancaria"
                                ${item.formaPago === "Transferencia bancaria" ? "selected" : ""}>
                                🏦 Transferencia bancaria
                            </option>

                            <option value="Mercado Pago"
                                ${item.formaPago === "Mercado Pago" ? "selected" : ""}>
                                📱 Mercado Pago
                            </option>

                            <option value="Tarjeta de débito"
                                ${item.formaPago === "Tarjeta de débito" ? "selected" : ""}>
                                💳 Tarjeta de débito
                            </option>

                            <option value="Tarjeta de crédito"
                                ${item.formaPago === "Tarjeta de crédito" ? "selected" : ""}>
                                💳 Tarjeta de crédito
                            </option>

                        </select>

                    </div>

                </div>

                <button
                    class="btn-eliminar"
                   onclick="eliminarProducto(${index}, this)">
                    🗑️
                </button>

            </div>
        `;

    }).join('');

    totalSpan.innerText = `$${total.toLocaleString()}`;
}

function cambiarFormaPago(index, formaPago) {

    const item = carrito[index];

    item.formaPago = formaPago;
    
    // Guardar también en MySQL
    fetch('/Home/ActualizarFormaPago', {

        method: 'POST',

        headers: {
            'Content-Type': 'application/json'
        },

        body: JSON.stringify({

            productoId: item.id,

            talle: item.talle,

            formaPago: formaPago

        })

    })
    .then(response => response.json())
    .then(data => {

        if (!data.exito) {

            console.error(
                "No se pudo actualizar la forma de pago:",
                data.mensaje
            );

            return;
        }

        console.log(
            "Forma de pago guardada en MySQL:",
            formaPago
        );

    })
    .catch(error => {

        console.error(
            "Error al guardar forma de pago:",
            error
        );

    });
}
 // ============================================
        // ELIMINAR
        // ============================================

  async function eliminarProducto(index, boton) {
    const producto = carrito[index];

    if (!producto) return;

    boton.classList.remove("tacho-animado");
    void boton.offsetWidth;
    boton.classList.add("tacho-animado");

    await new Promise(resolve =>
        boton.addEventListener("animationend", resolve, { once: true })
    );

    const parametros = new URLSearchParams({
        productoId: producto.id,
        color: producto.color || "",
        talle: producto.talle || ""
    });

    try {
        const respuesta = await fetch(
            `/Home/EliminarDelCarrito?${parametros}`,
            { method: "POST" }
        );

        const resultado = await respuesta.json();

        if (!resultado.exito) {
            Swal.fire({
                icon: "error",
                text: resultado.mensaje || "No se pudo eliminar el producto."
            });
            return;
        }

        carrito.splice(index, 1);
        cargarCarrito();
        sonidoEliminar();
        animarCarrito();
    } catch (error) {
        console.error("Error al eliminar el producto:", error);
    }
}

function sonidoEliminar() {

    const audioContext =
        new Audio('/sounds/carrito-eliminar.wav').play();

    const oscilador =
        audioContext.createOscillator();

    const volumen =
        audioContext.createGain();

    oscilador.type = "sine";

    oscilador.frequency.setValueAtTime(
        500,
        audioContext.currentTime
    );

    oscilador.frequency.exponentialRampToValueAtTime(
        250,
        audioContext.currentTime + 0.15
    );

    volumen.gain.setValueAtTime(
        0.15,
        audioContext.currentTime
    );

    volumen.gain.exponentialRampToValueAtTime(
        0.001,
        audioContext.currentTime + 0.15
    );

    oscilador.connect(volumen);

    volumen.connect(audioContext.destination);

    oscilador.start();

    oscilador.stop(
        audioContext.currentTime + 0.15
    );
}

// ============================================
// ANIMACIÓN DEL CARRITO
// ============================================

function animarCarrito() {
    const carritoIcono = document.getElementById("iconoCarrito");

    if (!carritoIcono) return;

    carritoIcono.classList.remove("mover");
    void carritoIcono.offsetWidth;
    carritoIcono.classList.add("mover");
}

async function vaciarCarrito() {
    try {
        const respuesta = await fetch('/Home/VaciarCarrito', {
            method: 'POST'
        });

        const resultado = await respuesta.json();

        if (!resultado.exito) {
            Swal.fire({
                icon: "error",
                text: resultado.mensaje || "No se pudo vaciar el carrito."
            });
            return;
        }

        carrito = [];
        cargarCarrito();

        const sonido = new Audio('/sounds/carrito-vaciar.wav');
        sonido.play().catch(() => {});

        animarCarrito();

        Swal.fire({
            toast: true,
            position: "top-end",
            icon: "success",
            title: "Carrito vaciado",
            showConfirmButton: false,
            timer: 1500
        });
    } catch (error) {
        console.error("Error al vaciar el carrito:", error);
    }
}

function enviarWhatsApp() {

    if (carrito.length === 0) {

