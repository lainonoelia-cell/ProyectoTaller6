        `%0AAtentamente,`;

    mensaje +=
        `%0AEquipo MMyM Indumentaria`;

    const numero = "5491155555555";

    const url =
        `https://wa.me/${numero}?text=${mensaje}`;

    window.open(url, '_blank');
}

