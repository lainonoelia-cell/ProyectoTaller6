@model List<ProyectoTaller6.Models.Producto>

@{
    ViewData["Title"] = "Categoria";

}

<link rel="stylesheet" href="~/css/categoria.css" />
<link rel="stylesheet" href="~/css/badges.css" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&display=swap"
      rel="stylesheet"/>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


<h1 class="titulo">@ViewBag.Tipo</h1>

<button onclick="mostrarFormulario()" class="btn-nuevo">➕ Nuevo Producto</button>

<div id="formNuevo" style="display:none; margin-top:20px;">

    <input type="text" id="nombre" placeholder="Nombre" />
    <input type="number" id="stock" placeholder="Stock" />
    <input type="number" id="precio" placeholder="Precio" />
    <input type="text" id="imagen" placeholder="Nombre imagen (ej: remera.png)" />

<select id="tipo">

    <option value="General">General</option>

    @foreach (var s in ViewBag.Subcategorias)
    {
        <option value="@s.Nombre">
            @s.Nombre
        </option>
    }

</select>

    <button class="btn-guardar" onclick="crearProducto()"> Guardar ✅ </button>
</div>

<script>
function mostrarFormulario() {
    document.getElementById("formNuevo").style.display = "block";
}
</script>

<script>
function crearProducto() {

    let nombre = document.getElementById("nombre").value;
    let stock = document.getElementById("stock").value;
    let precio = document.getElementById("precio").value;
    let imagen = document.getElementById("imagen").value;
    let tipo = document.getElementById("tipo").value;

    fetch('/Home/CrearProducto', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({
            Nombre: nombre,
            Stock: parseInt(stock),
            Precio: parseInt(precio),
            Imagen: imagen,
            Categoria: '@ViewBag.Tipo',
            Tipo: tipo
        })
    })
    .then(res => res.json())
    .then(data => {

        if (data.ok) {

            Swal.fire({
                icon: "success",
                title: "Producto creado",
                text: "El producto se creó correctamente."
            }).then(() => {
                location.reload();
            });

        } else {

            Swal.fire({
                icon: "error",
                title: "Error",
                text: data.mensaje
            });

        }

    });

}
</script>

<!-- FILTROS DINAMICOS -->
<div class="subcategorias">

<button onclick="filtrar('Todos')">
    Todos
</button>

@foreach (var s in ViewBag.Subcategorias)
{
    <div style="display:inline-block; margin:8px; text-align:center;">

        <button onclick="filtrar('@s.Nombre')">
            @s.Nombre
        </button>

        <br />

        <button onclick="editarSubcategoria(@s.Id,'@s.Nombre')">
            ✏
        </button>

        <button onclick="eliminarSubcategoria(@s.Id)">
            🗑
        </button>

    </div>
}

</div>

<input type="text" id="nuevaSub" placeholder="Nueva subcategoría" />

<button class="btn-subcategoria" onclick="crearSub()">Agregar Subcategoría </button>

<script>
function crearSub() {

    let nombre = document.getElementById("nuevaSub").value;

    fetch('/Home/CrearSubcategoria', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            Nombre: nombre,
            Categoria: '@ViewBag.Tipo'
        })
    })
    .then(res => res.json())
    .then(data => {

    if(data.ok)
    {
        Swal.fire({
            icon: "success",
            title: "Subcategoría creada",
            text: "La subcategoría se creó correctamente."
        }).then(() => {
            location.reload();
        });
    }
    else
    {
        Swal.fire({
            icon: "error",
            title: "Error",
            text: data.mensaje
        });
    }

});
}

function editarSubcategoria(id, nombre) {

    Swal.fire({
        title: "Editar subcategoría",
        input: "text",
        inputValue: nombre,
        inputPlaceholder: "Nuevo nombre",
        showCancelButton: true,
        confirmButtonText: "Guardar",
        cancelButtonText: "Cancelar",
        inputValidator: (value) => {
            if (!value) {
                return "Debe ingresar un nombre";
            }
        }
    }).then((result) => {

        if (!result.isConfirmed)
            return;

        fetch("/Home/EditarSubcategoria", {

            method: "PUT",

            headers: {
                "Content-Type": "application/json"
            },

            body: JSON.stringify({

                Id: id,
                Nombre: result.value

            })

        })
        .then(r => r.json())
        .then(data => {

            if (data.ok) {

                Swal.fire({
                    icon: "success",
                    title: "Subcategoría actualizada",
                    text: data.mensaje
                }).then(() => {
                    location.reload();
                });

            }
            else {

                Swal.fire({
                    icon: "error",
                    title: "Error",
                    text: data.mensaje
                });

            }

        });

    });

}


function eliminarSubcategoria(id)
{
    Swal.fire({
        title: "¿Eliminar SubCategoría?",
        text: "Esta acción no se puede deshacer.",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#d33",
        cancelButtonColor: "#3085d6",
        confirmButtonText: "Sí, eliminar",
        cancelButtonText: "Cancelar"
    }).then((result) => {

        if (!result.isConfirmed)
            return;

        fetch("/Home/EliminarSubCategoria?id=" + id, {
            method: "DELETE"
        })
        .then(r => r.json())
        .then(data => {

            if(data.ok)
            {
                Swal.fire({
                    icon: "success",
                    title: "Eliminada",
                    text: data.mensaje
                }).then(() => {
                    location.reload();
                });
            }
            else
            {
                Swal.fire({
                    icon: "error",
                    title: "No se pudo eliminar",
                    text: data.mensaje
                });
            }

        });

    });
}
</script>

<!-- PRODUCTOS -->
<div class="contenedor">

    @foreach (var p in Model)
    {
        <div class="producto" data-tipo="@p.Tipo">

            @if (!string.IsNullOrEmpty(p.Badge))
            {
                <span class="badge @p.ColorBadge">
                    @p.Badge
                </span>
            }

            <img src="/images/@p.Imagen" />

            <p class="nombre-producto">@p.Nombre</p>
           
            <p class="@(p.Stock == 0 ? "stock-agotado" :
           p.Stock <= 5 ? "stock-bajo" :
           "stock-ok")">

                Stock: @p.Stock

            </p>

<p class="precio-producto">
    Precio: $@p.Precio
</p>
            <div class="acciones">
                <a href="/Home/EditarProducto?id=@p.Id">
    <button>Editar</button>
</a>
                <button onclick="eliminarProducto(@p.Id)">Eliminar</button>
                <button onclick="agregarCodigo(@p.Id)">Agregar</button>
            </div>
        </div>
    }

</div>

<script>
function filtrar(tipo) {
    let productos = document.querySelectorAll(".producto");

    productos.forEach(p => {
        if (tipo === "Todos" || p.dataset.tipo === tipo) {
            p.style.display = "block";
        } else {
            p.style.display = "none";
        }
    });
}
</script>

<!-- CAMARA -->
<div class="camara">
    <a href="/Home/EscaneoCodigo">
        <img src="~/images/camara2.png" />
    </a> 

    

</div>




<script>
function agregarCodigo(idProducto) {

    fetch('/Home/GenerarCodigoProducto?id=' + idProducto)
    .then(res => res.json())
    .then(data => {

        if (data.ok) {

            Swal.fire({
                icon: "success",
                title: "Código generado",
                html: `
                    <p>El código se generó correctamente.</p>
                    <input id="codigoGenerado"
                           class="swal2-input"
                           value="${data.codigo}"
                           readonly>
                `,
                confirmButtonText: "Copiar código",
                showCancelButton: true,
                cancelButtonText: "Cerrar"
            }).then((result) => {

                if (result.isConfirmed) {

                    const input = document.getElementById("codigoGenerado");
                    input.select();
                    document.execCommand("copy");

                    Swal.fire({
                        icon: "success",
                        title: "Copiado",
                        text: "El código fue copiado al portapapeles."
                    });

                }

            });

        }
        else {

            Swal.fire({
                icon: "error",
                title: "Error",
                text: "No se pudo generar el código."
            });

        }

    });

}
</script>


<script>
function eliminarProducto(id)
{
    Swal.fire({
        title: "¿Eliminar producto?",
        text: "Esta acción no se puede deshacer.",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#d33",
        cancelButtonColor: "#3085d6",
        confirmButtonText: "Sí, eliminar",
        cancelButtonText: "Cancelar"
    }).then((result) => {

        if (!result.isConfirmed)
            return;

        fetch('/Home/EliminarProducto?id=' + id, {
            method: 'POST'
        })
        .then(res => res.json())
        .then(data => {

            if(data.ok)
            {
                Swal.fire({
                    icon: "success",
                    title: "Producto eliminado",
                    text: data.mensaje
                }).then(() => {
                    location.reload();
                });
            }
            else
            {
                Swal.fire({
                    icon: "error",
                    title: "No se pudo eliminar",
                    text: data.mensaje
                });
            }

        });

    });

}
</script>
