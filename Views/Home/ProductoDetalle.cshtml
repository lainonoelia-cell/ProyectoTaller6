async function cargarValoracionesProductos() {

    try {

        const respuesta =
            await fetch('/Home/ObtenerValoracionesProductos');

        const resultado =
            await respuesta.json();

        if (!resultado.exito) {
            return;
        }

        resultado.valoraciones.forEach(valoracion => {

            const contenedor =
                document.getElementById(
                    `valoracion-${valoracion.productoId}`
                );

            if (!contenedor) {
                return;
            }

            const promedio =
                Number(valoracion.promedio);

            const cantidad =
                Number(valoracion.cantidad);

            const estrellas =
                Math.round(promedio);

            let estrellasHTML = "";

            for (let i = 1; i <= 5; i++) {

                estrellasHTML +=
                    i <= estrellas
                        ? "★"
                        : "☆";
            }

            contenedor.innerHTML = `
    <span class="estrellas-llenas">
        ${estrellasHTML}
    </span>
    <span class="valoracion-promedio">
        ${promedio.toFixed(1).replace(".", ",")}
    </span>
    <span class="valoracion-cantidad">
        (${cantidad})
    </span>

    <button type="button"
            class="btn-valorar"
            onclick="abrirModalValoracion(${valoracion.productoId})">
        ⭐ Valorar producto
    </button>
`;
        });

    } catch (error) {

        console.error(
            "Error al cargar valoraciones:",
            error
        );

    }
}

