let favoritos = [];

// ============================================
// AGREGAR / QUITAR FAVORITO
// ============================================

async function toggleFavorito(id) {

    const boton = document.getElementById(`favorito-${id}`);

    if (!boton) {
        return;
    }

    const tarjeta = boton.closest('.card-producto');

    const nombreElemento = tarjeta
        ? tarjeta.querySelector('h3')
        : null;

    const nombre = nombreElemento
        ? nombreElemento.innerText.trim()
        : 'Producto';

    try {

        const respuesta = await fetch('/Home/ToggleFavorito', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                productoId: id
            })
        });

        const resultado = await respuesta.json();

        if (!resultado.exito) {

            mostrarNotificacion(
                `⚠️ ${resultado.mensaje}`
            );

            return;
        }

        // ==========================================
        // ACTUALIZAR LISTA LOCAL SOLO COMO ESTADO VISUAL
        // ==========================================

        if (resultado.favorito) {

            if (!favoritos.includes(id)) {
                favoritos.push(id);
            }

            mostrarNotificacion(
                `❤️ ${nombre} agregado a favoritos`
            );

        } else {

            favoritos =
                favoritos.filter(
                    favoritoId => favoritoId !== id
                );

            mostrarNotificacion(
                `♡ ${nombre} eliminado de favoritos`
            );
        }

        actualizarIconoFavorito(id);
        actualizarContadorFavoritos();

    } catch (error) {

        console.error(
            'Error al actualizar favorito:',
            error
        );

        mostrarNotificacion(
            '⚠️ No se pudo actualizar favoritos.'
        );
    }
}


// ============================================
// ACTUALIZAR CORAZÓN
// ============================================

function actualizarIconoFavorito(id) {

    const boton =
        document.getElementById(`favorito-${id}`);

    if (!boton) {
        return;
    }

    const esFavorito =
        favoritos.includes(id);

    if (esFavorito) {

        boton.innerText = "♥";

        boton.classList.add(
            "favorito-activo"
        );

        boton.title =
            "Quitar de favoritos";

    } else {

        boton.innerText = "♡";

        boton.classList.remove(
            "favorito-activo"
        );

        boton.title =
            "Agregar a favoritos";
    }
}

// ============================================
// ❤️ ACTUALIZAR CONTADOR DE FAVORITOS
// ============================================

function actualizarContadorFavoritos() {
    const contador = document.getElementById("contadorFavoritos");

    if (!contador) {
        return;
    }

    contador.innerText = favoritos.length;
}

// ============================================
// CARGAR FAVORITOS DESDE MYSQL
// ============================================

async function cargarFavoritos() {

    try {

        const respuesta =
            await fetch('/Home/ObtenerFavoritos');

        const resultado =
            await respuesta.json();

        if (!resultado.exito) {
            return;
        }

        favoritos =
            resultado.favoritos.map(
                favorito => favorito.id
            );

        favoritos.forEach(id => {

            actualizarIconoFavorito(id);

        });

        actualizarContadorFavoritos();

    } catch (error) {

        console.error(
            'Error al cargar favoritos:',
            error
        );
    }
}

