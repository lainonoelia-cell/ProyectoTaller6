async function quitarFavoritoDesdeModal(id) {

    try {

        const respuesta = await fetch('/Home/ToggleFavorito', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                productoId: id
            })
        });

        const resultado = await respuesta.json();

        if (!resultado.exito) {

            mostrarNotificacion(
                `⚠️ ${resultado.mensaje}`
            );

            return;
        }

        // Si el producto fue quitado correctamente
        if (!resultado.favorito) {

            favoritos = favoritos.filter(
                favoritoId => favoritoId !== id
            );

            // Actualizar el corazón de la tarjeta
            actualizarIconoFavorito(id);

            // Actualizar contador
            actualizarContadorFavoritos();

            // Actualizar nuevamente el contenido del modal
            cargarListaFavoritosModal();

            mostrarNotificacion(
                '♡ Producto eliminado de favoritos'
            );
        }

    } catch (error) {

        console.error(
            'Error al quitar favorito desde el modal:',
            error
        );

        mostrarNotificacion(
            '⚠️ No se pudo quitar el favorito.'
        );
    }
}


