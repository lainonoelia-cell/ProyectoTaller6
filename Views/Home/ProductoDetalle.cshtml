        @functions {

    public string ObtenerClaseColorRazor(string color)
    {
        var clases = new Dictionary<string, string>
        {
            { "Negro", "negro" },
            { "Blanco", "blanco" },
            { "Mostaza", "mostaza" },
            { "Azul", "azul" },
            { "Rojo", "rojo" },
            { "Verde", "verde" },
            { "Rosa", "rosa" },
            { "Gris", "gris" },
            { "Celeste", "celeste" },
            { "Naranja", "naranja" },
            { "Lila", "lila" },
            { "Crema", "crema" },
            { "Bordo", "bordo" },
            { "Cemento", "cemento" },
            { "Marron", "marron" },
            { "Beige", "beige" },
            { "Amarillo", "amarillo" }
        };

        return clases.ContainsKey(color)
            ? clases[color]
            : "";
    }
}
}



