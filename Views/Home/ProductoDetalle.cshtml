<script>

        // ============================================
        // CATEGORÍA
        // ============================================

        let categoriaSeleccionada = '@ViewBag.Categoria';


        // ============================================
        // CARRITO
        // ============================================

        let carrito = [];

// ============================================
// VARIANTES DE TODOS LOS PRODUCTOS
// ============================================

const variantesProducto = @Html.Raw(
    System.Text.Json.JsonSerializer.Serialize(
        variantes.Select(v => new
        {
            productoId = v.ProductoId,
            color = v.Color,
            talle = v.Talle,
            stock = v.Stock
        })
    )
);

function seleccionarColor(productoId, color) {

    // ==========================================
    // MARCAR COLOR SELECCIONADO
    // ==========================================

    const botones =
        document.querySelectorAll(
            `#colores-${productoId} .color-icono`
        );

    botones.forEach(boton => {

        boton.classList.remove("seleccionado");

        if (
            boton.dataset.color.trim().toLowerCase() ===
            color.trim().toLowerCase()
        ) {
            boton.classList.add("seleccionado");
        }

    });


    // ==========================================
    // MOSTRAR NOMBRE DEL COLOR
    // ==========================================

    const nombreColor =
        document.getElementById(
            `nombreColor-${productoId}`
        );

    if (nombreColor) {
        nombreColor.innerText =
            `Color seleccionado: ${color}`;
    }


    // ==========================================
    // BUSCAR VARIANTES DE ESE COLOR
    // ==========================================

    const variantesColor =
        variantesProducto.filter(v =>

            Number(v.productoId) === Number(productoId) &&

            v.color &&
            v.color.trim().toLowerCase() ===
            color.trim().toLowerCase()

        );


    // ==========================================
    // MOSTRAR TALLES
    // ==========================================

    mostrarTalles(
        productoId,
        color,
        variantesColor
    );
}

function mostrarTalles(
    productoId,
    color,
    variantesColor
) {

    const container =
        document.getElementById(
            `talles-${productoId}`
        );

    const stockContainer =
        document.getElementById(
            `stockSeleccionado-${productoId}`
        );

    const cantidadSelect =
        document.getElementById(
            `cantidad-${productoId}`
        );


    container.innerHTML = "";

    stockContainer.innerHTML = "";


    cantidadSelect.innerHTML = `
        <option value="0">
            
        </option>
    `;


    if (variantesColor.length === 0) {

        container.innerHTML = `
            <div class="mensaje-talles">
                No hay talles disponibles para este color.
            </div>
        `;

        return;
    }

const equivalenciasTalle = {
    S: "1",
    M: "2",
    L: "3",
    XL: "4",
    XXL: "5",
    XXXL: "6",
    "38": "S",
    "40": "M",
    "42": "L",
    "44": "XL",
    "46": "XXL",
    "48": "XXXL",
"50": "4XL"
};
  

    variantesColor.forEach((variante, index) => {

        const talle = variante.talle;
        const equivalencia =
    equivalenciasTalle[String(talle).trim().toUpperCase()];
    
        const stock = Number(variante.stock) || 0;


        const boton =
            document.createElement("button");

        boton.type = "button";

        boton.className =
            "talle-opcion";


        boton.dataset.talle =
            talle;


        boton.innerHTML = `
    <span class="talle-nombre">
        ${talle}${equivalencia ? ` (${equivalencia})` : ""}
    </span>

            <span class="talle-stock">
                Stock: ${stock}
            </span>
        `;


        if (stock <= 0) {

            boton.disabled = true;

            boton.classList.add(
                "talle-agotado"
            );

        }


        boton.addEventListener(
            "click",
            function () {

                seleccionarTalle(
                    productoId,
                    color,
                    talle,
                    stock,
                    boton
                );

            }
        );


        container.appendChild(
            boton
        );

    });

}

function seleccionarTalle(
    productoId,
    color,
    talle,
    stock,
    boton
) {

    const botones =
        document.querySelectorAll(
            `#talles-${productoId} .talle-opcion`
        );


    botones.forEach(b => {

        b.classList.remove(
            "talle-seleccionado"
        );

    });


    boton.classList.add(
        "talle-seleccionado"
    );


    // ==========================================
    // STOCK
    // ==========================================

    const stockContainer =
        document.getElementById(
            `stockSeleccionado-${productoId}`
        );


    if (stock <= 0) {

        stockContainer.innerHTML =
            "❌ Sin stock";

        return;
    }


    stockContainer.innerHTML =
        `📦 Stock disponible: <strong>${stock}</strong> unidades`;


    // ==========================================
    // CANTIDADES
    // ==========================================

    const cantidadSelect =
        document.getElementById(
            `cantidad-${productoId}`
        );


    cantidadSelect.innerHTML = "";


    for (
        let i = 1;
        i <= stock;
        i++
    ) {

        const option =
            document.createElement("option");

        option.value = i;

        option.textContent =
            `${i} unidad${i === 1 ? "" : "es"}`;

        cantidadSelect.appendChild(
            option
        );

    }


    // ==========================================
    // GUARDAR SELECCIÓN
    // ==========================================

    cantidadSelect.dataset.color =
        color;

    cantidadSelect.dataset.talle =
        talle;

    cantidadSelect.dataset.stock =
        stock;

}
        // ============================================
        // AGREGAR PRODUCTO
        // ============================================

        function agregarAlCarrito(id, nombre, precio, stock) {

    const cantidadSelect =
    document.getElementById(
        `cantidad-${id}`
    );


const color =
    cantidadSelect?.dataset.color || "";


const talle =
    cantidadSelect?.dataset.talle || "";


const stockVariante =
    Number(
        cantidadSelect?.dataset.stock || 0
    );


const cantidad =
    parseInt(
        cantidadSelect?.value || 0
    );

    if (!color) {

    mostrarNotificacion(
        "🎨 Seleccioná un color."
    );

    return;
}


if (!talle) {

    mostrarNotificacion(
        "📏 Seleccioná un talle."
    );

    return;
}


if (stockVariante <= 0) {

    mostrarNotificacion(
        "❌ Esta variante está sin stock."
    );

    return;
}


if (cantidad <= 0) {

    mostrarNotificacion(
        "❌ Seleccioná una cantidad válida."
    );

    return;
}


if (cantidad > stockVariante) {

    mostrarNotificacion(
        "❌ No hay suficiente stock para esta variante."
    );

    return;
}


    // ==========================================
    // VALIDAR CANTIDAD
    // ==========================================

    if (cantidad <= 0) {

        mostrarNotificacion(
            "❌ La cantidad seleccionada no es válida."
        );

        return;
    }


    // ==========================================
    // VERIFICAR STOCK EN EL CARRITO LOCAL
    // ==========================================

    const existe =
    carrito.find(
        item =>
            item.id === id &&
            item.color === color &&
            item.talle === talle
    );


    if (existe) {

       if (existe.cantidad + cantidad > stockVariante) {

    mostrarNotificacion(
        `No hay suficiente stock de ${nombre} en color ${color} y talle ${talle}.`
    );

    return;
}

    }
    else {
if (cantidad > stockVariante) {

    mostrarNotificacion(
        `No hay suficiente stock de ${nombre} en color ${color} y talle ${talle}.`
    );

    return;
}

    }


    // ==========================================
    // GUARDAR EN MYSQL
    // ==========================================

    fetch('/Home/AgregarAlCarrito', {

        method: 'POST',

        headers: {
            'Content-Type': 'application/json'
        },

       body: JSON.stringify({
    productoId: id,
    color: color,
    talle: talle,
    cantidad: cantidad,
    precio: precio
})

    })
    .then(response => response.json())
    .then(data => {

        if (!data.exito) {

            mostrarNotificacion(
                "❌ " + data.mensaje
            );

            return;
        }

        if (existe) {

            existe.cantidad += cantidad;

        }
        else {

            carrito.push({
    id: id,
    nombre: nombre,
    precio: precio,
    color: color,
    talle: talle,
    cantidad: cantidad,
    stock: stockVariante
});
        }


        actualizarCarrito();

        sonidoAgregar();

        animarCarrito();


        mostrarNotificacion(
            `🛒 ${nombre} agregado al carrito`
        );


        console.log(
            "Producto guardado en MySQL. Carrito:",
            data.carritoId
        );

    })
    .catch(error => {

        console.error(
            "Error al guardar en MySQL:",
            error
        );

        mostrarNotificacion(
            "❌ No se pudo guardar el producto en MySQL."
        );

    });

}


        // ============================================
        // ACTUALIZAR CARRITO
        // ============================================

        function actualizarCarrito() {

            const container =
                document.getElementById('listaCarrito');

            const totalSpan =
                document.getElementById('totalCarrito');


            let total = 0;


            if (carrito.length === 0) {

                container.innerHTML =
                    '<div class="sin-productos">' +
                    'No hay productos en el carrito' +
                    '</div>';

                totalSpan.innerText = '$0';

                return;
            }


            let html = '';


            carrito.forEach((item, index) => {

                const subtotal =
                    item.precio * item.cantidad;


                total += subtotal;


                html += `

            

                    <div class="item-carrito">

                        <div class="item-info">

                            <strong>
                                ${item.nombre}
                            </strong>

                            <br>

                            <small>
    Color: ${item.color}
    |
    Talle: ${item.talle}
    |
    Cantidad: ${item.cantidad}
</small>

                        </div>


                        <div class="item-precio">

                            $${subtotal.toLocaleString()}

                        </div>


                        <button
                            class="btn-eliminar"
                            onclick="eliminarDelCarrito(${index})">

                            🗑️

                        </button>

                    </div>

                `;

            });


            container.innerHTML = html;


            totalSpan.innerText =
                `$${total.toLocaleString()}`;

        }


        // ============================================
        // ELIMINAR
        // ============================================

        async function eliminarDelCarrito(index) {
    const producto = carrito[index];
    if (!producto) return;

    const parametros = new URLSearchParams({
        productoId: producto.id,
        color: producto.color || "",
        talle: producto.talle || ""
    });

    try {
        const respuesta = await fetch(
            `/Home/EliminarDelCarrito?${parametros}`,
            { method: "POST" }
        );

        const resultado = await respuesta.json();

        if (!resultado.exito) {
            mostrarNotificacion(
                resultado.mensaje || "No se pudo eliminar el producto."
            );
            return;
        }

        carrito.splice(index, 1);
        actualizarCarrito();
        sonidoEliminar();
        animarCarrito();

        mostrarNotificacion(`${producto.nombre} eliminado del carrito`);
    } catch (error) {
        console.error("Error al eliminar el producto:", error);
        mostrarNotificacion("No se pudo conectar con el servidor.");
    }
}


        // ============================================
        // CONFIRMAR COMPRA
        // ============================================
function confirmarCompra() {

    if (carrito.length === 0) {

        alert("No hay productos en el carrito");

        return;
    }

    const nombreCliente =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(usuarioRed));

    if (!nombreCliente) {

        alert(
            "Por favor ingresá el nombre del cliente."
        );

        return;
    }

    sonidoConfirmarCompra();

    if (navigator.vibrate) {

        navigator.vibrate([
            150,
            80,
            150
        ]);

    }

    let mensaje =
        "¡Hola! Quiero realizar el siguiente pedido:%0A%0A";

    mensaje +=
        ` Cliente: ${nombreCliente}%0A%0A`;

    carrito.forEach(item => {

    mensaje +=
        `• ${item.nombre}` +
        ` - Color: ${item.color}` +
        ` - Talle: ${item.talle}` +
        ` - Cantidad: ${item.cantidad}%0A`;

});

    const total =
        carrito.reduce(
            (sum, item) =>
                sum +
                (item.precio * item.cantidad),
            0
        );

    mensaje +=
        `%0ATotal estimado: $${total.toLocaleString()}`;

    mensaje +=
        `%0A%0A¡Gracias por su compra!`;

    mensaje +=
        `%0AAtentamente,%0AEquipo MM&M Indumentaria`;

    const numeroWhatsApp =
        "5491155555555";

    const url =
        `https://wa.me/${numeroWhatsApp}?text=${mensaje}`;

    window.open(url, '_blank');
}
       

        // ============================================
        // MODAL
        // ============================================

