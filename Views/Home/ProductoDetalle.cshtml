        function obtenerColorCSS(color) {

    const colores = {

        "Negro": "#000000",
        "Blanco": "#ffffff",
        "Mostaza": "#e5b800",
        "Azul": "#2563eb",
        "Rojo": "#dc2626",
        "Verde": "#4d7c3a",
        "Rosa": "#ec8ab8",
        "Gris": "#808080",
        "Celeste": "#6ec6e8",
        "Naranja": "#f97316",
        "Lila": "#b794d6",
        "Crema": "#f3e6c8",
        "Bordo": "#7f1d1d",
        "Cemento": "#8c8c8c",
        "Marron": "#795548",
        "Beige": "#d8c3a5",
        "Amarillo": "#ffd900"

    };

    return colores[color] || "#cccccc";
}

function obtenerGradienteCombinacion(combinacion) {

    const colores =
        combinacion
            .split("/")
            .map(c => c.trim())
            .filter(c => c !== "");


    if (colores.length === 2) {

        return `
            linear-gradient(
                135deg,
                ${obtenerColorCSS(colores[0])} 0%,
                ${obtenerColorCSS(colores[0])} 50%,
                ${obtenerColorCSS(colores[1])} 50%,
                ${obtenerColorCSS(colores[1])} 100%
            )
        `;

    }


    if (colores.length === 3) {

        return `
            linear-gradient(
                135deg,
                ${obtenerColorCSS(colores[0])} 0%,
                ${obtenerColorCSS(colores[0])} 33.33%,
                ${obtenerColorCSS(colores[1])} 33.33%,
                ${obtenerColorCSS(colores[1])} 66.66%,
                ${obtenerColorCSS(colores[2])} 66.66%,
                ${obtenerColorCSS(colores[2])} 100%
            )
        `;

    }


    return obtenerColorCSS(colores[0]);

}

