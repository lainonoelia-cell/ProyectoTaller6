// =========================================================
// ❤️ CARGAR FAVORITOS DESDE MYSQL EN EL MODAL
// =========================================================

async function cargarListaFavoritosModal() {

    const lista = document.getElementById("listaFavoritos");

    if (!lista) {
        console.error("No se encontró #listaFavoritos.");
        return;
    }

    // Mensaje mientras cargamos
    lista.innerHTML = `
        <div class="favoritos-cargando">
            ❤️ Cargando tus favoritos...
        </div>
    `;

    try {

        const respuesta = await fetch("/Home/ObtenerFavoritos");

        const resultado = await respuesta.json();

        if (!resultado.exito) {

            lista.innerHTML = `
                <div class="favoritos-vacio">
                    ⚠️ No se pudieron cargar tus favoritos.
                </div>
            `;

            return;
        }

        // Actualizamos también nuestro array global
        favoritos = resultado.favoritos.map(favorito => favorito.id);

        actualizarContadorFavoritos();

        // Si no hay favoritos
        if (resultado.favoritos.length === 0) {

            lista.innerHTML = `
                <div class="favoritos-vacio">
                    ❤️ Todavía no tenés productos favoritos.
                </div>
            `;

            return;
        }

        // Dibujamos los favoritos
        lista.innerHTML = resultado.favoritos.map(favorito => {

            const imagen = favorito.imagen
                ? (
                    favorito.imagen.startsWith("/images/")
                        ? favorito.imagen
                        : `/images/${favorito.imagen}`
                )
                : "";

            return `
                <div class="favorito-item">

                    <div class="favorito-imagen">
                        ${
                            imagen
                                ? `<img src="${imagen}" alt="${favorito.nombre}">`
                                : `<div class="favorito-sin-imagen">♡</div>`
                        }
                    </div>

                    <div class="favorito-datos">

                        <h3>${favorito.nombre}</h3>

                        <p class="favorito-precio">
                            $${Number(favorito.precio).toLocaleString("es-AR", {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            })}
                        </p>

                    </div>

                    <button
                        type="button"
                        class="btn-quitar-favorito"
                        onclick="quitarFavoritoDesdeModal(${favorito.id})"
                        title="Quitar de favoritos">
                        ♥
                    </button>

                </div>
            `;

        }).join("");

    } catch (error) {

        console.error("Error al cargar favoritos:", error);

        lista.innerHTML = `
            <div class="favoritos-vacio">
                ⚠️ Ocurrió un error al cargar tus favoritos.
            </div>
        `;
    }
}

