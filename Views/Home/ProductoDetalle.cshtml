let productoValoracionActual = 0;
let puntuacionSeleccionada = 0;


// ---------------------------------------------------------
// ⭐ ABRIR MODAL
// ---------------------------------------------------------

function abrirModalValoracion(productoId) {

    productoValoracionActual = productoId;
    puntuacionSeleccionada = 0;

    const botones =
        document.querySelectorAll(
            "#estrellasValoracion button"
        );

    botones.forEach(boton => {
        boton.textContent = "☆";
    });

    document.getElementById(
        "comentarioValoracion"
    ).value = "";

    document.getElementById(
        "modalValoracion"
    ).style.display = "flex";
}

// ---------------------------------------------------------
// ❌ CERRAR MODAL
// ---------------------------------------------------------

function cerrarModalValoracion() {

    document.getElementById(
        "modalValoracion"
    ).style.display = "none";
}


// ---------------------------------------------------------
// ⭐ SELECCIONAR ESTRELLAS
// ---------------------------------------------------------

function seleccionarEstrella(puntuacion) {

    puntuacionSeleccionada = puntuacion;

    const botones =
        document.querySelectorAll(
            "#estrellasValoracion button"
        );

    botones.forEach((boton, indice) => {

        if (indice < puntuacion) {
            boton.textContent = "★";
        } else {
            boton.textContent = "☆";
        }

    });
}


async function enviarValoracion() {
    if (!productoValoracionActual) {
        mostrarNotificacion("No se encontró el producto.");
        return;
    }

    if (puntuacionSeleccionada < 1 || puntuacionSeleccionada > 5) {
        mostrarNotificacion("Seleccioná una puntuación de 1 a 5 estrellas.");
        return;
    }

    const comentario =
        document.getElementById("comentarioValoracion").value.trim();

    try {
        const respuesta = await fetch("/Home/AgregarValoracion", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                productoId: Number(productoValoracionActual),
                puntuacion: Number(puntuacionSeleccionada),
                comentario: comentario
            })
        });

        const resultado = await respuesta.json();

        if (!respuesta.ok || !resultado.exito) {
            mostrarNotificacion(
                resultado.mensaje || "No se pudo guardar la valoración."
            );
            return;
        }

        cerrarModalValoracion();
        mostrarNotificacion(resultado.mensaje);
        await cargarValoracionesProductos();
    } catch (error) {
        console.error("Error al enviar la valoración:", error);
        mostrarNotificacion("No se pudo enviar la valoración. Revisá la conexión.");
    }
}
