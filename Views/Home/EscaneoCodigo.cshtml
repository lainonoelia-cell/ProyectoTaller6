@{
    ViewData["Title"] = "Escaneo Codigo";
}

<link rel="stylesheet" href="~/css/escaneo.css" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&display=swap"
      rel="stylesheet"/>


<h1 class="titulo">ESCANEO CÓDIGO PRODUCTO</h1>

<div class="contenedor-escaneo">

    <div class="contenedor-principal">


    <p class="mensaje">
        Por favor, apunte la cámara al código de la prenda
    </p>

    <!-- 📷 CAMARA -->
    <div class="camara-grande">
        <img src="~/images/camara2.png" onclick="iniciarEscaneo()" style="cursor:pointer;" />
    </div>

    <div id="reader" style="width:300px; display:none;"></div>

    <!-- FLASH EFFECTS -->
    <div id="flashOk" class="flash ok"></div>
    <div id="flashError" class="flash error"></div>

    <!-- RESULTADOS -->
    <p id="ok1" class="resultado1 ok1" style="display:none;">
        Producto encontrado ✅
    </p>

    <p id="error1" class="resultado1 error1" style="display:none;">
        Producto no encontrado ❌
</p>

    <!-- MANUAL -->
    <div class="manual">
        <input type="text" id="codigoInput" placeholder="Ingresar código manual" />
        <button onclick="buscarCodigo()">Buscar 🔎</button>
    </div>

    </div>

    <!-- TARJETA FLOTANTE -->

<div id="tarjetaProducto"
     class="producto-modal"
     style="display:none;">

    <div class="producto-card">

        <img id="imgProducto"
             class="foto-producto"
             src="">

        <h2 id="nombreProducto"></h2>

        <div class="datos">

            <div class="infoProducto">

    <div class="fila">
        <span class="tituloDato">Código</span>
        <span id="codigoProducto"></span>
    </div>

    <div class="fila">
        <span class="tituloDato">Precio</span>
        <span>$<span id="precioProducto"></span></span>
    </div>

    <div class="fila">
        <span class="tituloDato">Stock</span>
        <span id="stockProducto"></span>
    </div>

    <div class="fila">
        <span class="tituloDato">Categoría</span>
        <span id="categoriaProducto"></span>
    </div>

</div>

        </div>

        <div class="botones">

            <button
                class="btn-detalle"
                onclick="verDetalle()">

                📄 Ver detalle

            </button>

            <button
              class="btn-etiqueta"
              onclick="imprimirEtiqueta()">
           🖨 Imprimir etiqueta
           </button>

            <button
                class="btn-cancelar"
                onclick="cerrarTarjeta()">

                ❌ Cancelar

            </button>

        </div>

    </div>

</div>

<div id="modalEtiqueta" class="modal-etiqueta">

    <div class="etiqueta">

         <button
        class="cerrar"
        onclick="cerrarEtiqueta()">

        ✖

    </button>

        <img
            src="/images/logoMM.png"
            class="logoEtiqueta">

        <h2 id="etNombre"></h2>

        <h3 id="etCodigo"></h3>

        <h2 id="etPrecio"></h2>

        <button
            class="btn-imprimir"
            onclick="window.print()">

            🖨 Imprimir

        </button>

    </div>

</div>


<div class="estadisticas">

    <span>Total:
        <strong id="totalEscaneos">0</strong>
    </span>

    <span style="color:green">
        Disponibles:
        <strong id="disp">0</strong>
    </span>

    <span style="color:red">
        Agotados:
        <strong id="agot">0</strong>
    </span>

    <span style="color:#555">
    No encontrados:
        <strong id="error">0</strong>
    </span>

</div>

</div>


<div class="botones-historial">

    <button class="btn-limpiar" onclick="limpiarHistorial()">
        🗑️ Limpiar historial
    </button>

    <button class="btn-exportar" onclick="exportarCSV()">
        💾 Exportar historial
    </button>

</div>


<div class="historial">

    <h2>Historial de escaneos</h2>
    <div class="tabla-scroll">

    <table id="tablaHistorial">

        <thead>

            <tr>

                <th>Hora</th>
                <th>Producto</th>
                <th>Código</th>
                <th>Stock</th>
                <th>Estado</th>

            </tr>

        </thead>

        <tbody>

        </tbody>

    </table>
    </div>

</div>

</div> <!-- contenedor-escaneo -->


<!-- 📷 SCANNER + LOGICA -->
<script>

let sonidoOk = new Audio("/sounds/success.mp3");
let sonidoError = new Audio("/sounds/error.mp3");

let scanner;
window.speechSynthesis.onvoiceschanged = () => {};

let codigoEscaneado = "";
// HISTORIAL
let total = 0;
let disponibles = 0;
let agotados = 0;
let errores = 0;


// 🔊 VOZ
function hablar(texto) {

    // Reinicia cualquier voz anterior
    window.speechSynthesis.cancel();

    const mensaje = new SpeechSynthesisUtterance(texto);

    mensaje.lang = "es-ES";
    mensaje.rate = 1;
    mensaje.pitch = 1;
    mensaje.volume = 1;

    // Espera pequeña para estabilizar Chrome
    setTimeout(() => {
        window.speechSynthesis.speak(mensaje);
    }, 250);
}


// 📷 INICIAR ESCANEO
function iniciarEscaneo() {

     sonidoOk.play().then(() => {
        sonidoOk.pause();
        sonidoOk.currentTime = 0;
    }).catch(()=>{});

    sonidoError.play().then(() => {
        sonidoError.pause();
        sonidoError.currentTime = 0;
    }).catch(()=>{});

    document.getElementById("reader").style.display = "block";

    scanner = new Html5Qrcode("reader");

    Html5Qrcode.getCameras().then(cameras => {

        let cameraId = cameras[0].id;

        scanner.start(
            cameraId,
            { fps: 10, qrbox: 250 },
            (codigo) => {

                codigo = codigo.trim();

                document.getElementById("codigoInput").value = codigo;

                validarCodigo(codigo);

                scanner.stop();
            }
        );

    });
}


// 🟢 VALIDAR CODIGO
function validarCodigo(codigo) {

    fetch("/Home/BuscarPorCodigo?codigo=" + codigo)

    .then(r => r.json())

    .then(data => {

        if (!data.encontrado) {

            feedbackError();
            agregarError(codigo);


            return;

        }

        feedbackOk();

let mensaje = "Producto encontrado. " + data.nombre + ".";

if(data.stock > 0){

    mensaje += " Stock disponible " + data.stock;

}else{

    mensaje += " Stock agotado.";

}

setTimeout(()=>{

    hablar(mensaje);

},700);

mostrarProducto(data,codigo);

agregarHistorial(data,codigo);

    });

}

function mostrarProducto(data, codigo) {

    codigoEscaneado = codigo;

    document.getElementById("imgProducto").src =
        "/images/" + data.imagen;

    document.getElementById("nombreProducto").innerText =
        data.nombre;

    document.getElementById("codigoProducto").innerText =
        codigo;

    document.getElementById("precioProducto").innerText =
        Number(data.precio).toLocaleString("es-AR");

    document.getElementById("stockProducto").innerText =
        data.stock;

    document.getElementById("categoriaProducto").innerText =
        data.categoria;

    // Mostrar la ficha
    document.getElementById("tarjetaProducto").style.display = "flex";

    // Ocultar la cámara
document.querySelector(".camara-grande").style.display = "none";

// Ocultar el lector QR
document.getElementById("reader").style.display = "none";

// Ocultar búsqueda manual
document.querySelector(".manual").style.display = "none";

// Ocultar el mensaje
document.querySelector(".mensaje").style.display = "none";
}

// 🟢 BUSQUEDA MANUAL
function buscarCodigo() {

    let codigo =
        document.getElementById("codigoInput").value.trim();

    if (!codigo) return;

    validarCodigo(codigo);
}


// ✅ OK
function feedbackOk() {

    document.getElementById("ok1").style.display="block";
    document.getElementById("error1").style.display="none";

    const flash=document.getElementById("flashOk");

    flash.style.display="flex";

    try{

        sonidoOk.currentTime=0;
        sonidoOk.play();

    }catch(e){}

    setTimeout(()=>{

        flash.style.display="none";

    },1000);

}


// ❌ ERROR
function feedbackError() {

    document.getElementById("error1").style.display = "block";
    document.getElementById("ok1").style.display = "none";

    const flash = document.getElementById("flashError");

    flash.style.display = "flex";

    if (navigator.vibrate) {
        navigator.vibrate(200);
    }

    try {

        sonidoError.currentTime = 0;
        sonidoError.play();

        // ⏳ ESPERA PARA LA VOZ
        setTimeout(() => {
           hablar("Producto no encontrado");
        }, 700);

    }
    catch (e) {}

    setTimeout(() => {
        flash.style.display = "none";
    }, 900);
    
}


function agregarHistorial(producto,codigo){

    let hora = new Date().toLocaleTimeString();

    let estado;

    if(producto.stock > 0){

        estado = "🟢 Disponible";
        disponibles++;

    }else{

        estado = "🔴 Agotado";
        agotados++;

    }

    total++;

    let fila = `

<tr>

<td>${hora}</td>

<td>${producto.nombre}</td>

<td>${codigo}</td>

<td>${producto.stock}</td>

<td>${estado}</td>

</tr>

`;

    document
        .querySelector("#tablaHistorial tbody")
        .insertAdjacentHTML("beforeend",fila);

    actualizarEstadisticas();

}

function actualizarEstadisticas(){

    document.getElementById("totalEscaneos").innerText = total;

    document.getElementById("disp").innerText = disponibles;

    document.getElementById("agot").innerText = agotados;

    document.getElementById("error").innerText = errores;

}

function agregarError(codigo){

    let hora = new Date().toLocaleTimeString();

    total++;
    errores++;

    let fila = `

<tr>

<td>${hora}</td>

<td>No encontrado</td>

<td>${codigo}</td>

<td>-</td>

<td>⚫ No encontrado</td>

</tr>

`;

    document
        .querySelector("#tablaHistorial tbody")
        .insertAdjacentHTML("beforeend",fila);

    actualizarEstadisticas();

}

function verDetalle() {

    window.location.href =
        "/Home/Inventario2?codigo=" + codigoEscaneado;

}

function cerrarTarjeta() {

    document.getElementById("tarjetaProducto").style.display = "none";

    document.querySelector(".camara-grande").style.display = "block";

    document.querySelector(".manual").style.display = "flex";

    document.querySelector(".mensaje").style.display = "block";

}

function imprimirEtiqueta() {

    document.getElementById("etNombre").innerText =
        document.getElementById("nombreProducto").innerText;

    document.getElementById("etCodigo").innerText =
        document.getElementById("codigoProducto").innerText;

    document.getElementById("etPrecio").innerText =
        "$ " + document.getElementById("precioProducto").innerText;

    document.getElementById("modalEtiqueta").style.display = "flex";

}

function cerrarEtiqueta(){

    document.getElementById("modalEtiqueta").style.display="none";

}


function irInventario2(){

    window.location.href="/Home/Inventario2?codigo="+codigoEscaneado;

}
    function limpiarHistorial(){

    document.querySelector("#tablaHistorial tbody").innerHTML="";

    total = 0;
    disponibles = 0;
    agotados = 0;
    errores = 0;

    actualizarEstadisticas();

}



    function exportarCSV() {

    let tabla = document.getElementById("tablaHistorial");

    let csv = [];

    for (let fila of tabla.rows) {

        let datos = [];

        for (let celda of fila.cells) {

            datos.push(celda.innerText);

        }

        csv.push(datos.join(";"));
    }

    let archivo = new Blob(
        [csv.join("\n")],
        {
            type: "text/csv;charset=utf-8;"
        }
    );

    let enlace = document.createElement("a");

    enlace.href = URL.createObjectURL(archivo);

    enlace.download = "HistorialEscaneos.csv";

    document.body.appendChild(enlace);

    enlace.click();

    document.body.removeChild(enlace);

    URL.revokeObjectURL(enlace.href);
}

</script>



